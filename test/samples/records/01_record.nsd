<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Rec&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;type Punkt = record{x: int; y: int}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;p := Punkt{x: 3, y: 4}&#34;,&#34;var q: Punkt&#34;,&#34;q.x := 7&#34;,&#34;OUTPUT p.x + p.y, &#34;&#34; &#34;&#34;, q.x&#34;,&#34;OUTPUT abstand(p)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;abstand(pt)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<jump text="&#34;return pt.x * pt.x + pt.y * pt.y&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
