<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Schleifengrenzen&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;n := 3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for i := -3 to -1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="-3" endValue="-1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;a&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for i := 0 to n - 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="0" endValue="n - 1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;b&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for i := n downto 0 + 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="n" endValue="0 + 1" stepConst="-1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;c&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for i := 1 to 2 * n - 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="2 * n - 1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;d&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for i := -1 to -1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="-1" endValue="-1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;e&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
