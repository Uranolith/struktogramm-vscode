		<for text="&#34;for p := 0 to length(a) - 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="p" startValue="0" endValue="length(a) - 1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
