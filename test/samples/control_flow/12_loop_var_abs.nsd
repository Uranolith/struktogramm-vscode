<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;ZaehlerAbs&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<for text="&#34;for i := -2 to 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="-2" endValue="1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT abs(i), &#34;&#34; &#34;&#34;, i * i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for k := 3 to -1 step -1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="3" endValue="-1" stepConst="-1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT abs(k) mod 2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
