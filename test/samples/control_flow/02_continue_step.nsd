<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Weiter&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<for text="&#34;for i := 10 to 0 step -2&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="10" endValue="0" stepConst="-2" style="COUNTER" disabled="0">
			<qFor>
				<alternative text="&#34;i = 4&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<jump text="&#34;continue&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
				<instruction text="&#34;OUTPUT i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;k := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<repeat text="&#34;until k &#62;= 6&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qRepeat>
				<instruction text="&#34;k := k + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;k mod 2 = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<jump text="&#34;continue&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
				<instruction text="&#34;OUTPUT &#34;&#34;k &#34;&#34;, k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qRepeat>
		</repeat>
		<instruction text="&#34;j := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;while j &#60; 5&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;j := j + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;j = 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<jump text="&#34;continue&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
				<instruction text="&#34;OUTPUT &#34;&#34;j &#34;&#34;, j&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qWhile>
		</while>
	</children>
</root>
