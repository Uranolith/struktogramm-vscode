<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Returns&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;OUTPUT name(1), &#34;&#34; &#34;&#34;, name(2), &#34;&#34; &#34;&#34;, name(9)&#34;,&#34;OUTPUT finde(7)&#34;,&#34;OUTPUT finde(100)&#34;,&#34;OUTPUT vorzeichen(-4)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;name(k)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<case text="&#34;k&#34;,&#34;1&#34;,&#34;2&#34;,&#34;default&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qCase>
					<jump text="&#34;return &#34;&#34;eins&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qCase>
				<qCase>
					<jump text="&#34;return &#34;&#34;zwei&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qCase>
				<qCase>
					<jump text="&#34;return &#34;&#34;viele&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qCase>
			</case>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;finde(z)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<for text="&#34;for i := 1 to 10&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="10" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<alternative text="&#34;i * i &#62;= z&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;return i&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
						</qFalse>
					</alternative>
				</qFor>
			</for>
			<jump text="&#34;return -1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;vorzeichen(v)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;v &#60; 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return -1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<alternative text="&#34;v = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;return 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
							<jump text="&#34;return 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qFalse>
					</alternative>
				</qFalse>
			</alternative>
		</children>
	</root>
</roots>
