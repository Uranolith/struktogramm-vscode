<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Verschachtelt&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<for text="&#34;for i := 1 to 3&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<for text="&#34;for j := 1 to 3&#34;" comment="&#34;&#34;" color="ffffff" counterVar="j" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
					<qFor>
						<alternative text="&#34;j &#62; i&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
							<qTrue>
								<jump text="&#34;leave&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
							</qTrue>
							<qFalse>
							</qFalse>
						</alternative>
						<instruction text="&#34;OUTPUT i, &#34;&#34;,&#34;&#34;, j&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qFor>
				</for>
			</qFor>
		</for>
		<instruction text="&#34;n := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<forever comment="&#34;&#34;" color="ffffff" disabled="0">
			<qForever>
				<forever comment="&#34;&#34;" color="ffffff" disabled="0">
					<qForever>
						<instruction text="&#34;n := n + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<alternative text="&#34;n &#62;= 4&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
							<qTrue>
								<jump text="&#34;leave 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
							</qTrue>
							<qFalse>
							</qFalse>
						</alternative>
					</qForever>
				</forever>
			</qForever>
		</forever>
		<instruction text="&#34;OUTPUT &#34;&#34;n=&#34;&#34;, n&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
