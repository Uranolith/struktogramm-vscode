<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Schleifen&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT n&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for i := 1 to n&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="n" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for i := n downto 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="n" endValue="1" stepConst="-1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT &#34;&#34;nach: &#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for k := 1 to n step 2&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="1" endValue="n" stepConst="2" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;k&#34;&#34;, k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;for z := 5 to 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="z" startValue="5" endValue="1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;nie&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
