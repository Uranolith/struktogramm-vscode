<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Lesen&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;f := fileCreate(&#34;&#34;t.txt&#34;&#34;)&#34;,&#34;fileWriteLine(f, &#34;&#34;17 2.5 \&#34;&#34;zwei Worte\&#34;&#34; {1, 2} 8&#34;&#34;)&#34;,&#34;fileWriteLine(f, &#34;&#34;Ende&#34;&#34;)&#34;,&#34;fileClose(f)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;g := fileOpen(&#34;&#34;t.txt&#34;&#34;)&#34;,&#34;zahl := 0&#34;,&#34;kz := 0.5&#34;,&#34;txt := &#34;&#34;x&#34;&#34;&#34;,&#34;roh := &#34;&#34;&#34;&#34;&#34;,&#34;feld := {0, 0, 0}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;zahl := fileRead(g)&#34;,&#34;kz := fileRead(g)&#34;,&#34;txt := fileRead(g)&#34;,&#34;roh := fileRead(g)&#34;,&#34;feld[1] := fileRead(g)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT zahl + 1, &#34;&#34; &#34;&#34;, kz * 2, &#34;&#34; &#34;&#34;, txt, &#34;&#34; &#34;&#34;, roh, &#34;&#34; &#34;&#34;, feld[1] * 3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;rest := fileReadLine(g)&#34;,&#34;OUTPUT &#34;&#34;[&#34;&#34;, rest, &#34;&#34;] &#34;&#34;, fileReadLine(g)&#34;,&#34;fileClose(g)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
