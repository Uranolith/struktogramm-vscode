<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Datei&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT a&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;f := fileCreate(&#34;&#34;daten.txt&#34;&#34;)&#34;,&#34;fileWriteLine(f, &#34;&#34;Hallo Welt&#34;&#34;)&#34;,&#34;fileWriteLine(f, 42)&#34;,&#34;fileWrite(f, 2.5)&#34;,&#34;fileWriteLine(f, &#34;&#34;&#34;&#34;)&#34;,&#34;fileWriteLine(f, &#34;&#34;3 -7 1.25 Öl&#34;&#34;)&#34;,&#34;fileWriteLine(f, a &#62; 3)&#34;,&#34;fileWriteLine(f, &#34;&#34;Summe &#34;&#34; + (a + 1))&#34;,&#34;fileClose(f)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;g := fileOpen(&#34;&#34;daten.txt&#34;&#34;)&#34;,&#34;OUTPUT &#34;&#34;Nummer &#34;&#34;, g&#34;,&#34;z := fileReadLine(g)&#34;,&#34;OUTPUT z&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;n := fileReadInt(g)&#34;,&#34;d := fileReadDouble(g)&#34;,&#34;OUTPUT n + 1, &#34;&#34; &#34;&#34;, d * 2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;k := fileReadInt(g)&#34;,&#34;m := fileReadInt(g)&#34;,&#34;x := fileReadDouble(g)&#34;,&#34;w := fileReadLine(g)&#34;,&#34;OUTPUT k, &#34;&#34; &#34;&#34;, m, &#34;&#34; &#34;&#34;, x, &#34;&#34; [&#34;&#34;, w, &#34;&#34;]&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;t := fileReadLine(g)&#34;,&#34;OUTPUT t&#34;,&#34;OUTPUT fileReadLine(g)&#34;,&#34;OUTPUT fileEOF(g)&#34;,&#34;fileClose(g)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
