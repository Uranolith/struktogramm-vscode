<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;RangeKopie&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;type P = record{x: int; n: string}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;p := P{x: 1, n: &#34;&#34;a&#34;&#34;}&#34;,&#34;q := copyRecord(p)&#34;,&#34;q.x := 5&#34;,&#34;OUTPUT p.x, &#34;&#34; &#34;&#34;, q.x, &#34;&#34; &#34;&#34;, q.n&#34;,&#34;r := range(5)&#34;,&#34;r[0] := 9&#34;,&#34;OUTPUT length(r), &#34;&#34; &#34;&#34;, r[0], &#34;&#34; &#34;&#34;, r[4]&#34;,&#34;s := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach k in range(2, 4)&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;foreach k in r&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;s := s + k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT s&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
