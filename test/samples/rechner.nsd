<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-17" changedby="" changed="2026-11-17" origin="Struktogramm-Editor (VS Code)" text="&#34;rechner&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;var zahl: int&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;INPUT &#34;&#34;Zahl: &#34;&#34;, zahl&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;s = 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<for text="&#34;for i = 1 to zahl&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="zahl" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<instruction text="&#34;s = s + i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<instruction text="&#34;OUTPUT &#34;&#34;Summe: &#34;&#34;, s&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<alternative text="&#34;ist_prim(zahl)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<instruction text="&#34;OUTPUT zahl, &#34;&#34; ist prim&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTrue>
				<qFalse>
					<alternative text="&#34;zahl % 2 == 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<instruction text="&#34;OUTPUT &#34;&#34;gerade&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qTrue>
						<qFalse>
							<instruction text="&#34;OUTPUT &#34;&#34;ungerade&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qFalse>
					</alternative>
				</qFalse>
			</alternative>
			<while text="&#34;while zahl &#62; 0 and s != 3&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qWhile>
					<instruction text="&#34;zahl = zahl div 2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qWhile>
			</while>
			<case text="&#34;zahl&#34;,&#34;0&#34;,&#34;1, 2&#34;,&#34;default&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;null&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;klein&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;groß&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
			</case>
			<instruction text="&#34;x = 10&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<repeat text="&#34;until x &#60; 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qRepeat>
					<instruction text="&#34;x = x - 3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qRepeat>
			</repeat>
			<instruction text="&#34;OUTPUT summe(x, 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-17" changedby="" changed="2026-11-17" origin="Struktogramm-Editor (VS Code)" text="&#34;summe(a: int; b: int): int&#34;" comment="&#34;Addiert zwei Zahlen.&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<jump text="&#34;return a + b&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-17" changedby="" changed="2026-11-17" origin="Struktogramm-Editor (VS Code)" text="&#34;ist_prim(n)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;n &#60; 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return false&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<for text="&#34;for i = 2 to int(sqrt(n))&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="2" endValue="int(sqrt(n))" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<alternative text="&#34;n % i == 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;return false&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
						</qFalse>
					</alternative>
				</qFor>
			</for>
			<jump text="&#34;return true&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
