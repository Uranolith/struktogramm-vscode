<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;FeldParam&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;a := {5, 3, 8, 1}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<call text="&#34;sortiere(a)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></call>
			<instruction text="&#34;OUTPUT a[0], &#34;&#34; &#34;&#34;, a[3]&#34;,&#34;OUTPUT summe(a), &#34;&#34; &#34;&#34;, anzahl(a)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;sortiere(f)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<for text="&#34;for i := 0 to length(f) - 2&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="0" endValue="length(f) - 2" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<for text="&#34;for j := 0 to length(f) - 2 - i&#34;" comment="&#34;&#34;" color="ffffff" counterVar="j" startValue="0" endValue="length(f) - 2 - i" stepConst="1" style="COUNTER" disabled="0">
						<qFor>
							<alternative text="&#34;f[j] &#62; f[j + 1]&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
								<qTrue>
									<instruction text="&#34;h := f[j]&#34;,&#34;f[j] := f[j + 1]&#34;,&#34;f[j + 1] := h&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
								</qTrue>
								<qFalse>
								</qFalse>
							</alternative>
						</qFor>
					</for>
				</qFor>
			</for>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;summe(f)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<instruction text="&#34;s := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<for text="&#34;foreach v in f&#34;" comment="&#34;&#34;" color="ffffff" counterVar="v" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
				<qFor>
					<instruction text="&#34;s := s + v&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<jump text="&#34;return s&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;anzahl(f)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<jump text="&#34;return length(f)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
