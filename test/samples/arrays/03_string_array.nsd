<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;TextFeld&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;namen := {&#34;&#34;Anna&#34;&#34;, &#34;&#34;Bert&#34;&#34;, &#34;&#34;Carl&#34;&#34;}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<for text="&#34;for i := 0 to length(namen) - 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="0" endValue="length(namen) - 1" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<instruction text="&#34;OUTPUT i, &#34;&#34;: &#34;&#34;, namen[i]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<instruction text="&#34;namen[1] := &#34;&#34;Bob&#34;&#34;&#34;,&#34;OUTPUT namen[1]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;z := {1.5, 2.5}&#34;,&#34;OUTPUT z[0] + z[1]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT erste(namen)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;erste(arr)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<jump text="&#34;return arr[0]&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
