<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Spezialfall 03: Große Ganzzahl&#34;" comment="&#34;15! = 1307674368000 passt nicht in eine 32-Bit-Ganzzahl.&#34;" color="ffffff" type="program" style="nice">
	<children>
