<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Spezialfall 09: Feld&#34;" comment="&#34;Feld-Literal, Länge, Indexzugriff und foreach.&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;a := {5, 3, 8}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;summe := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for i := 0 to length(a) - 1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="0" endValue="length(a) - 1" stepConst="1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;summe := summe + a[i]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT summe, &#34;&#34; &#34;&#34;, a[1]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach w in a&#34;" comment="&#34;&#34;" color="ffffff" counterVar="w" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT w&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
