<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Spezialfall 26: foreach über einen Text&#34;" comment="&#34;foreach über die Zeichen eines eingelesenen Textes: jedes Zeichen mit Position ausgeben, Vokale (Fallauswahl) und ein bestimmtes Zeichen (Vergleich) zählen.&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT wort&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;vokale := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;anzahlN := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;position := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach z in wort&#34;" comment="&#34;&#34;" color="ffffff" counterVar="z" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;position := position + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT position, &#34;&#34;: &#34;&#34;, z&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<case text="&#34;z&#34;,&#34;&#34;&#34;a&#34;&#34;, &#34;&#34;e&#34;&#34;, &#34;&#34;i&#34;&#34;, &#34;&#34;o&#34;&#34;, &#34;&#34;u&#34;&#34;&#34;,&#34;default&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qCase>
						<instruction text="&#34;vokale := vokale + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
					<qCase>
					</qCase>
				</case>
				<alternative text="&#34;z = &#34;&#34;n&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<instruction text="&#34;anzahlN := anzahlN + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT &#34;&#34;Vokale: &#34;&#34;, vokale&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;Buchstabe n: &#34;&#34;, anzahlN&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
