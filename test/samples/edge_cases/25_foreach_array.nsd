<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Spezialfall 25: foreach über Felder&#34;" comment="&#34;foreach über ein Zahlenfeld (Summe), ein Textfeld, mit Abbruch (leave) beim Finden und über ein Feld-Literal im Schleifenkopf.&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;werte := {4, 8, 15, 16, 23, 42}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;summe := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach w in werte&#34;" comment="&#34;&#34;" color="ffffff" counterVar="w" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;summe := summe + w&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT &#34;&#34;Summe: &#34;&#34;, summe&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;namen := {&#34;&#34;Anna&#34;&#34;, &#34;&#34;Bert&#34;&#34;, &#34;&#34;Carla&#34;&#34;}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach name in namen&#34;" comment="&#34;&#34;" color="ffffff" counterVar="name" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT &#34;&#34;Hallo &#34;&#34;, name&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;INPUT gesucht&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;position := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;gefunden := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;foreach w in werte&#34;" comment="&#34;&#34;" color="ffffff" counterVar="w" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;position := position + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;w = gesucht&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<instruction text="&#34;gefunden := position&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<jump text="&#34;leave&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
			</qFor>
		</for>
		<alternative text="&#34;gefunden &#62; 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qTrue>
				<instruction text="&#34;OUTPUT gesucht, &#34;&#34; an Position &#34;&#34;, gefunden&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse>
				<instruction text="&#34;OUTPUT gesucht, &#34;&#34; nicht gefunden&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFalse>
		</alternative>
		<for text="&#34;foreach k in {1, 2, 3}&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
			<qFor>
				<instruction text="&#34;OUTPUT k * k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>
