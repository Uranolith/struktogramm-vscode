<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Spezialfall 19: Endlosschleife mit leave&#34;" comment="&#34;Endlosschleife, die mit leave verlassen wird.&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;i := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<forever comment="&#34;&#34;" color="ffffff" disabled="0">
			<qForever>
				<instruction text="&#34;i := i + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;i * i &#62; 50&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qTrue>
						<jump text="&#34;leave&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
			</qForever>
		</forever>
		<instruction text="&#34;OUTPUT i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
