<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;Gesamttest&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;INPUT n&#34;,&#34;werte := {3, 1, 4, 1, 5}&#34;,&#34;summe := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<for text="&#34;foreach w in werte&#34;" comment="&#34;&#34;" color="ffffff" counterVar="w" startValue="" stepConst="" style="TRAVERSAL" insep="in" disabled="0">
				<qFor>
					<instruction text="&#34;summe := summe + w&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<instruction text="&#34;OUTPUT &#34;&#34;Summe: &#34;&#34;, summe&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<alternative text="&#34;summe &#62; 10&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<instruction text="&#34;OUTPUT &#34;&#34;gross&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTrue>
				<qFalse>
					<instruction text="&#34;OUTPUT &#34;&#34;klein&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFalse>
			</alternative>
			<case text="&#34;n&#34;,&#34;1&#34;,&#34;7&#34;,&#34;default&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;eins&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;sieben&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;andere&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
			</case>
			<for text="&#34;for i := 1 to 3&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<instruction text="&#34;OUTPUT &#34;&#34;i = &#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<instruction text="&#34;k := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<while text="&#34;while k &#60; 3&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qWhile>
					<instruction text="&#34;k := k + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qWhile>
			</while>
			<repeat text="&#34;until k = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qRepeat>
					<instruction text="&#34;k := k - 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qRepeat>
			</repeat>
			<instruction text="&#34;z := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<forever comment="&#34;&#34;" color="ffffff" disabled="0">
				<qForever>
					<instruction text="&#34;z := z + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					<alternative text="&#34;z &#62;= 5&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;leave&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
						</qFalse>
					</alternative>
				</qForever>
			</forever>
			<instruction text="&#34;OUTPUT &#34;&#34;k = &#34;&#34;, k, &#34;&#34;, z = &#34;&#34;, z&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<call text="&#34;zeile(&#34;&#34;parallel&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></call>
			<parallel text="&#34;4&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qPara>
					<qPara>
						<instruction text="&#34;f := fib(n + 8)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qPara>
					<qPara>
						<instruction text="&#34;fak := fakultaet(n)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qPara>
					<qPara>
						<instruction text="&#34;s := summeBis(100)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qPara>
					<qPara>
						<call text="&#34;zuege := hanoi(5)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></call>
					</qPara>
				</qPara>
			</parallel>
			<instruction text="&#34;OUTPUT &#34;&#34;fib = &#34;&#34;, f&#34;,&#34;OUTPUT &#34;&#34;fak = &#34;&#34;, fak&#34;,&#34;OUTPUT &#34;&#34;s = &#34;&#34;, s&#34;,&#34;OUTPUT &#34;&#34;zuege = &#34;&#34;, zuege&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT &#34;&#34;fibPar = &#34;&#34;, fibPar(18)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<call text="&#34;zeile(&#34;&#34;try&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></call>
			<try text="&#34;fehler&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<instruction text="&#34;OUTPUT &#34;&#34;teile 10 durch 2: &#34;&#34;, teile(10, 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					<instruction text="&#34;q := teile(10, 0)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					<instruction text="&#34;OUTPUT &#34;&#34;nicht erreicht&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTry>
				<qCatch>
					<instruction text="&#34;OUTPUT &#34;&#34;Fehler: &#34;&#34;, fehler&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCatch>
				<qFinally>
					<instruction text="&#34;OUTPUT &#34;&#34;finally&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFinally>
			</try>
			<instruction text="&#34;OUTPUT &#34;&#34;ggt = &#34;&#34;, ggt(1071, 462)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;fib(k: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;k &#60; 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return k&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return fib(k - 1) + fib(k - 2)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;fakultaet(k: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;k &#60;= 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return k * fakultaet(k - 1)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;summeBis(k: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;k = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return k + summeBis(k - 1)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;hanoi(k: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;k = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return 2 * hanoi(k - 1) + 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;ggt(a: int, b: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;b = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return a&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return ggt(b, a mod b)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;teile(a: int, b: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;b = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;throw &#34;&#34;Division durch null&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<jump text="&#34;return a / b&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;zeile(text: string)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<instruction text="&#34;OUTPUT &#34;&#34;== &#34;&#34;, text, &#34;&#34; ==&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;fibPar(k: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;k &#60; 15&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return fib(k)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<parallel text="&#34;2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qPara>
							<qPara>
								<instruction text="&#34;a := fibPar(k - 1)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qPara>
							<qPara>
								<instruction text="&#34;b := fibPar(k - 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qPara>
						</qPara>
					</parallel>
					<jump text="&#34;return a + b&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
</roots>
