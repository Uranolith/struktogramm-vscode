<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Fehlertexte&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;z := 0&#34;,&#34;arr := {1, 2, 3}&#34;,&#34;k := 5&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<try text="&#34;e&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
