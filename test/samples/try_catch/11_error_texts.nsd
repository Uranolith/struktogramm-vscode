			<try text="&#34;e&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<instruction text="&#34;OUTPUT arr[-1]&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTry>
				<qCatch>
