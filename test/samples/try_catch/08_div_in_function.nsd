			</try>
			<instruction text="&#34;OUTPUT teile(9, 2), &#34;&#34; &#34;&#34;, 7.0 / 2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
