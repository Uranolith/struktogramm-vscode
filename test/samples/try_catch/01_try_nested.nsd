<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Fehler&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<try text="&#34;err&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<instruction text="&#34;OUTPUT wurzel(9)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					<instruction text="&#34;OUTPUT wurzel(-1)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTry>
				<qCatch>
					<instruction text="&#34;OUTPUT &#34;&#34;Fehler: &#34;&#34;, err&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCatch>
				<qFinally>
					<instruction text="&#34;OUTPUT &#34;&#34;immer&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFinally>
			</try>
			<try text="&#34;e2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<try text="&#34;e3&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTry>
							<jump text="&#34;throw &#34;&#34;innen&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTry>
						<qCatch>
							<instruction text="&#34;OUTPUT &#34;&#34;gefangen &#34;&#34;, e3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							<jump text="&#34;throw &#34;&#34;weiter&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qCatch>
						<qFinally>
						</qFinally>
					</try>
				</qTry>
				<qCatch>
					<instruction text="&#34;OUTPUT &#34;&#34;aussen &#34;&#34;, e2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCatch>
				<qFinally>
				</qFinally>
			</try>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;wurzel(x)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;x &#60; 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;throw &#34;&#34;negativ&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<jump text="&#34;return sqrt(x)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
