<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;FinallyWege&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<for text="&#34;for i := 1 to 3&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<try text="&#34;e&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTry>
							<alternative text="&#34;i = 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
								<qTrue>
									<jump text="&#34;leave&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
								</qTrue>
								<qFalse>
								</qFalse>
							</alternative>
							<instruction text="&#34;OUTPUT &#34;&#34;t&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qTry>
						<qCatch>
						</qCatch>
						<qFinally>
							<instruction text="&#34;OUTPUT &#34;&#34;f&#34;&#34;, i&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qFinally>
					</try>
				</qFor>
			</for>
			<for text="&#34;for k := 1 to 3&#34;" comment="&#34;&#34;" color="ffffff" counterVar="k" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<try text="&#34;e&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTry>
							<alternative text="&#34;k = 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
								<qTrue>
									<jump text="&#34;continue&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
								</qTrue>
								<qFalse>
								</qFalse>
							</alternative>
							<instruction text="&#34;OUTPUT &#34;&#34;w&#34;&#34;, k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qTry>
						<qCatch>
						</qCatch>
						<qFinally>
							<instruction text="&#34;OUTPUT &#34;&#34;g&#34;&#34;, k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qFinally>
					</try>
				</qFor>
			</for>
			<instruction text="&#34;OUTPUT h(1)&#34;,&#34;OUTPUT h(2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<try text="&#34;e2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<try text="&#34;e3&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTry>
							<jump text="&#34;throw &#34;&#34;innen&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTry>
						<qCatch>
							<instruction text="&#34;OUTPUT &#34;&#34;gefangen &#34;&#34;, e3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							<jump text="&#34;throw &#34;&#34;weiter&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qCatch>
						<qFinally>
							<instruction text="&#34;OUTPUT &#34;&#34;inneres finally&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						</qFinally>
					</try>
				</qTry>
				<qCatch>
					<instruction text="&#34;OUTPUT &#34;&#34;aussen &#34;&#34;, e2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCatch>
				<qFinally>
				</qFinally>
			</try>
			<instruction text="&#34;OUTPUT &#34;&#34;ende&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;h(x)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<try text="&#34;e&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTry>
					<alternative text="&#34;x = 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;throw &#34;&#34;a&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
						</qFalse>
					</alternative>
					<jump text="&#34;return x * 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTry>
				<qCatch>
					<instruction text="&#34;OUTPUT &#34;&#34;c &#34;&#34;, e&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					<jump text="&#34;return -1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qCatch>
				<qFinally>
					<instruction text="&#34;OUTPUT &#34;&#34;fin &#34;&#34;, x&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFinally>
			</try>
		</children>
	</root>
</roots>
