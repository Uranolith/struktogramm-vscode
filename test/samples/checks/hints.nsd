<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Hinweisbeispiele&#34;" comment="&#34;Zeigt die Hinweis-Prüfungen (gelbe Marken) mit Begründung. Der Kommentar jedes Elements nennt die erwarteten Hinweise.&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;INPUT n&#34;" comment="&#34;Hinweise: Eingabe ohne Aufforderungstext; n ohne Typ&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;summe := 0&#34;" comment="&#34;Hinweis: summe ohne Typ&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;var x: double&#34;,&#34;x := n / 3.0&#34;" comment="&#34;Hinweis: mehrere Anweisungen in einem Block&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<alternative text="&#34;x = 0.5&#34;" comment="&#34;Hinweis: Kommazahlen mit = verglichen&#34;" color="ffffff" disabled="0">
				<qTrue>
					<instruction text="&#34;OUTPUT &#34;&#34;halb&#34;&#34;&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<while text="&#34;while n &#62; 0&#34;" comment="&#34;Hinweis: n ändert sich in der Schleife nicht&#34;" color="ffffff" disabled="0">
				<qWhile>
					<instruction text="&#34;summe := summe + 1&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qWhile>
			</while>
			<while text="&#34;while summe &#60; 0&#34;" comment="&#34;Hinweise: leerer Schleifenrumpf; summe ändert sich nicht&#34;" color="ffffff" disabled="0">
				<qWhile>
				</qWhile>
			</while>
			<case text="&#34;n = 0&#34;,&#34;true&#34;,&#34;false&#34;" comment="&#34;Hinweis: Fallauswahl über eine Bedingung&#34;" color="ffffff" disabled="0">
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;null&#34;&#34;&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT n&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
			</case>
			<case text="&#34;true&#34;,&#34;n &#60; 10&#34;,&#34;n &#62; 10&#34;" comment="&#34;Hinweise: Bedingungen als Fallmarken; sonst-Zweig mit Bedingung beschriftet&#34;" color="ffffff" disabled="0">
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;klein&#34;&#34;&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
				<qCase>
					<instruction text="&#34;OUTPUT &#34;&#34;groß&#34;&#34;&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qCase>
			</case>
			<instruction text="&#34;w := &#34;&#34;Text&#34;&#34;&#34;" comment="&#34;Hinweis: w ohne Typ&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;w := 3&#34;" comment="&#34;Hinweis: w ist mal Text, mal Zahl&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;rest := n mod 2&#34;" comment="&#34;Hinweise: rest ohne Typ; Wert wird nie verwendet&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT summe, w, verdopple(n), x&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<forever comment="&#34;Hinweis: Endlosschleife ohne Ausstieg&#34;" color="ffffff" disabled="0">
				<qForever>
					<instruction text="&#34;OUTPUT &#34;&#34;immer&#34;&#34;&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qForever>
			</forever>
			<instruction text="&#34;exit 0&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT &#34;&#34;nie&#34;&#34;&#34;" comment="&#34;Hinweis: wird nie erreicht&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;verdopple(a)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<instruction text="&#34;return a * 2&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
</roots>
