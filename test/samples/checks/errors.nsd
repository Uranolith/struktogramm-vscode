<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;Fehlerbeispiele&#34;" comment="&#34;Absichtlich fehlerhaft: zeigt alle Fehler-Prüfungen (rote Marken). Der Kommentar jedes Elements nennt die erwartete Meldung.&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;var a: int&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;INPUT &#34;&#34;a: &#34;&#34;, a&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;b := a +&#34;" comment="&#34;Fehler: Syntaxfehler (unvollständiger Ausdruck)&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT c&#34;" comment="&#34;Fehler: c bekommt nirgends einen Wert&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;y := quadrat(a)&#34;" comment="&#34;Fehler: unbekannte Funktion quadrat&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;h := summe(1)&#34;" comment="&#34;Fehler: summe erwartet 2 Argumente&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;z := 10 / 0&#34;" comment="&#34;Fehler: Division durch 0&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;a = 5&#34;" comment="&#34;Fehler: Zuweisung mit = statt := (= ist der Vergleich)&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;leave&#34;" comment="&#34;Fehler: leave außerhalb einer Schleife&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<for text="&#34;for i := 1 to 3&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" counterVar="i" startValue="1" endValue="3" stepConst="1" style="COUNTER" disabled="0">
				<qFor>
					<instruction text="&#34;leave 2&#34;" comment="&#34;Fehler: leave 2, aber nur eine Schleife&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<for text="&#34;for i von 1&#34;" comment="&#34;Fehler: Schleifenkopf nicht lesbar&#34;" color="ffffff" style="FREETEXT" disabled="0">
				<qFor>
					<instruction text="&#34;OUTPUT i&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFor>
			</for>
			<alternative text="&#34;&#34;" comment="&#34;Fehler: leere Bedingung&#34;" color="ffffff" disabled="0">
				<qTrue>
					<instruction text="&#34;OUTPUT 1&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<instruction text="&#34;OUTPUT b, y, h, z&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-25" changedby="" changed="2026-11-25" origin="Struktograf (VS Code)" text="&#34;summe(x: int, y: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<instruction text="&#34;return x + y&#34;" comment="&#34;in Ordnung&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
</roots>
