<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;rekursion&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;OUTPUT fak(4)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;a := quadrat(3)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;b := quadrat(a)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT a, &#34;&#34; &#34;&#34;, b&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;fak(n: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;n &#60;= 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return 1&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
					<jump text="&#34;return n * fak(n - 1)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qFalse>
			</alternative>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-20" changedby="" changed="2026-11-20" origin="Struktograf (VS Code)" text="&#34;quadrat(x: int): int&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<instruction text="&#34;q := x * x&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<jump text="&#34;return q&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
