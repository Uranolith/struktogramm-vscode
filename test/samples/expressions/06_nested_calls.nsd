<?xml version="1.0" encoding="UTF-8"?>
<roots xmlns:nsd="https://structorizer.fisch.lu">
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Aufrufe&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
		<children>
			<instruction text="&#34;INPUT n&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<alternative text="&#34;istPrim(n)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<instruction text="&#34;OUTPUT n, &#34;&#34; ist prim&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qTrue>
				<qFalse>
					<instruction text="&#34;OUTPUT n, &#34;&#34; ist nicht prim&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qFalse>
			</alternative>
			<instruction text="&#34;OUTPUT max(min(n, 10), 3), &#34;&#34; &#34;&#34;, max(1, 2, 3)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<instruction text="&#34;OUTPUT abs(-n) + sqr(n)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		</children>
	</root>
	<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;istPrim(z)&#34;" comment="&#34;&#34;" color="ffffff" type="sub" style="nice">
		<children>
			<alternative text="&#34;z &#60; 2&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qTrue>
					<jump text="&#34;return false&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
				</qTrue>
				<qFalse>
				</qFalse>
			</alternative>
			<instruction text="&#34;t := 2&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			<while text="&#34;while t * t &#60;= z&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
				<qWhile>
					<alternative text="&#34;z mod t = 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
						<qTrue>
							<jump text="&#34;return false&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
						</qTrue>
						<qFalse>
						</qFalse>
					</alternative>
					<instruction text="&#34;t := t + 1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				</qWhile>
			</while>
			<jump text="&#34;return true&#34;" comment="&#34;&#34;" color="ffffff" disabled="0"></jump>
		</children>
	</root>
</roots>
