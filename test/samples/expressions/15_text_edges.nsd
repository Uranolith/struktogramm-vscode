<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;TextRand&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT s&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;[&#34;&#34;, insert(&#34;&#34;-&#34;&#34;, s, 9), &#34;&#34;] [&#34;&#34;, copy(s, 7, 3), &#34;&#34;] [&#34;&#34;, delete(s, 8, 2), &#34;&#34;] [&#34;&#34;, delete(s, 2, 9), &#34;&#34;]&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;k := length(s) + 2&#34;,&#34;OUTPUT insert(&#34;&#34;+&#34;&#34;, s, k), &#34;&#34; &#34;&#34;, copy(s, k, 1), &#34;&#34;|&#34;&#34;, delete(s, k, 1)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT uppercase(&#34;&#34;äöü straße é&#34;&#34;), &#34;&#34; &#34;&#34;, lowercase(&#34;&#34;ÄÖÜ GROSS É&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT ord(&#34;&#34;Ö&#34;&#34;), &#34;&#34; &#34;&#34;, ord(copy(s, 1, 1)), &#34;&#34; &#34;&#34;, ord(&#34;&#34;A&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
