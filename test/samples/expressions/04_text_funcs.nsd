<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Texte&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT s&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;r := &#34;&#34;&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for i := length(s) to 1 step -1&#34;" comment="&#34;&#34;" color="ffffff" counterVar="i" startValue="length(s)" endValue="1" stepConst="-1" style="COUNTER" disabled="0">
			<qFor>
				<instruction text="&#34;r := r + copy(s, i, 1)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;OUTPUT r&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT uppercase(s), lowercase(&#34;&#34;ABC&#34;&#34;), &#34;&#34; &#34;&#34;, pos(&#34;&#34;l&#34;&#34;, s)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;c := chr(ord(&#34;&#34;a&#34;&#34;) + 2)&#34;,&#34;OUTPUT c&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;n := strtoint(&#34;&#34;42&#34;&#34;) + 1&#34;,&#34;OUTPUT n&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;f := strtofloat(&#34;&#34;2.5&#34;&#34;) * 2&#34;,&#34;OUTPUT f&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT inttostr(7) + &#34;&#34;x&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT trim(&#34;&#34;  a b  &#34;&#34;), &#34;&#34;|&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT insert(&#34;&#34;XY&#34;&#34;, s, 2)&#34;,&#34;OUTPUT delete(s, 1, 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT length(&#34;&#34;&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
