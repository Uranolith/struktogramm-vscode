<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="" created="2026-11-26" changedby="" changed="2026-11-26" origin="Struktograf (VS Code)" text="&#34;Unendlich&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;x := 2.5&#34;,&#34;y := 0.0&#34;,&#34;z := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT x / y&#34;,&#34;OUTPUT -x / y&#34;,&#34;OUTPUT y / y&#34;,&#34;OUTPUT x / z&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;w := x / y&#34;,&#34;OUTPUT w + 1, &#34;&#34; &#34;&#34;, w &#62; 1000, &#34;&#34; &#34;&#34;, w * 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;n := y / y&#34;,&#34;OUTPUT n = n, &#34;&#34; &#34;&#34;, n &#60;&#62; n&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;Text &#34;&#34; + w&#34;,&#34;s := &#34;&#34;v=&#34;&#34; + (0 - w)&#34;,&#34;OUTPUT s&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;d := 1.0&#34;,&#34;OUTPUT d / 0, &#34;&#34; &#34;&#34;, sqrt(-1.0)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
