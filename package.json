{
  "name": "struktogramm",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.9.4",
  "publisher": "Uranolith",
  "icon": "media/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#173a8c",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uranolith/struktogramm-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Uranolith/struktogramm-vscode/issues"
  },
  "homepage": "https://github.com/Uranolith/struktogramm-vscode#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Programming Languages"
  ],
  "keywords": [
    "struktogramm",
    "nassi-shneiderman",
    "structorizer",
    "nsd",
    "flowchart",
    "ausführen",
    "debugger",
    "pascal",
    "cobol"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onDebugResolve:struktogramm",
    "onDebugDynamicConfigurations:struktogramm",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "struktogramm.editor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.nsd"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "struktograf",
          "title": "%container.struktograf%",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "struktografExecution",
          "title": "%container.execution%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "struktograf": [
        {
          "type": "webview",
          "id": "struktograf.tools",
          "name": "%view.tools%",
          "when": "struktograf.toolsInSidebar"
        }
      ],
      "struktografExecution": [
        {
          "type": "webview",
          "id": "struktograf.execution",
          "name": "%view.execution%",
          "when": "struktograf.execInPanel"
        }
      ]
    },
    "languages": [
      {
        "id": "nsd",
        "aliases": [
          "%lang.nsd%",
          "nsd"
        ],
        "extensions": [
          ".nsd"
        ],
        "configuration": "./syntaxes/nsd.language-configuration.json",
        "icon": {
          "light": "./media/nsd-light.svg",
          "dark": "./media/nsd-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nsd",
        "scopeName": "text.xml.nsd",
        "path": "./syntaxes/nsd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "struktogramm.fromCode",
        "title": "%cmd.fromCode%",
        "category": "%category%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "struktogramm.preview",
        "title": "%cmd.preview%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "struktogramm.toCode",
        "title": "%cmd.toCode%",
        "category": "%category%",
        "icon": "$(code)"
      },
      {
        "command": "struktogramm.newFile",
        "title": "%cmd.newFile%",
        "shortTitle": "%cmd.newFile.short%",
        "category": "%category%",
        "icon": "$(struktograf-new-file)"
      },
      {
        "command": "struktogramm.exportSvg",
        "title": "%cmd.exportSvg%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.exportPng",
        "title": "%cmd.exportPng%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.exportSingle",
        "title": "%cmd.exportSingle%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.fromCodeStructorizer",
        "title": "%cmd.fromCodeStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.run",
        "title": "%cmd.run%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "struktogramm.step",
        "title": "%cmd.step%",
        "category": "%category%",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "struktogramm.stop",
        "title": "%cmd.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "struktogramm.openInStructorizer",
        "title": "%cmd.openInStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.setupStructorizer",
        "title": "%cmd.setupStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export",
        "title": "%cmd.export%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "struktogramm.export.json",
        "title": "%cmd.export.json%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export.xml",
        "title": "%cmd.export.xml%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export.aiClip",
        "title": "%cmd.export.aiClip%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "struktogramm.pause",
        "title": "%cmd.pause%",
        "category": "%category%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "struktogramm.toggleToolbarLocation",
        "title": "%cmd.toggleToolbarLocation%",
        "category": "%category%",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "struktogramm.execution.clear",
        "title": "%cmd.execution.clear%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "struktogramm.toggleExecutionLocation",
        "title": "%cmd.toggleExecutionLocation%",
        "category": "%category%",
        "icon": "$(layout-panel)"
      },
      {
        "command": "struktogramm.tools.resetLayout",
        "title": "%cmd.tools.resetLayout%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "struktogramm.zoomIn",
        "title": "%cmd.zoomIn%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.zoomOut",
        "title": "%cmd.zoomOut%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.zoomReset",
        "title": "%cmd.zoomReset%",
        "category": "%category%"
      }
    ],
    "icons": {
      "struktograf-new-file": {
        "description": "%icon.newFile%",
        "default": {
          "fontPath": "media/struktograf-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "struktogramm.preview",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(kt|kts|rs)$/",
          "group": "navigation"
        },
        {
          "command": "struktogramm.run",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@0"
        },
        {
          "command": "struktogramm.toCode",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation"
        },
        {
          "command": "struktogramm.export",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@9"
        },
        {
          "command": "struktogramm.newFile",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "1_struktogramm@1"
        },
        {
          "command": "struktogramm.toggleToolbarLocation",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@10"
        },
        {
          "command": "struktogramm.toggleExecutionLocation",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "1_struktogramm@2"
        }
      ],
      "file/newFile": [
        {
          "command": "struktogramm.newFile",
          "group": "file"
        }
      ],
      "view/title": [
        {
          "command": "struktogramm.newFile",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.toggleToolbarLocation",
          "when": "view == struktograf.tools",
          "group": "navigation"
        },
        {
          "command": "struktogramm.run",
          "when": "view == struktograf.execution",
          "group": "navigation@1"
        },
        {
          "command": "struktogramm.step",
          "when": "view == struktograf.execution",
          "group": "navigation@2"
        },
        {
          "command": "struktogramm.pause",
          "when": "view == struktograf.execution",
          "group": "navigation@3"
        },
        {
          "command": "struktogramm.stop",
          "when": "view == struktograf.execution",
          "group": "navigation@4"
        },
        {
          "command": "struktogramm.execution.clear",
          "when": "view == struktograf.execution",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.toggleExecutionLocation",
          "when": "view == struktograf.execution",
          "group": "navigation@6"
        },
        {
          "command": "struktogramm.tools.resetLayout",
          "when": "view == struktograf.tools",
          "group": "9_layout"
        }
      ],
      "editor/context": [
        {
          "command": "struktogramm.fromCode",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(pas|dpr|pp|lpr|cob|cbl|cobol|pde|kt|kts|rs)$/",
          "group": "z_struktogramm@1"
        },
        {
          "command": "struktogramm.fromCodeStructorizer",
          "when": "resourceExtname =~ /^\\.(c|java|pas|dpr|pp|lpr|cob|cbl|cobol|pde)$/",
          "group": "z_struktogramm@2"
        },
        {
          "command": "struktogramm.preview",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(kt|kts|rs)$/",
          "group": "z_struktogramm@3"
        }
      ],
      "explorer/context": [
        {
          "command": "struktogramm.newFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.run",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@0"
        },
        {
          "command": "struktogramm.fromCode",
          "when": "resourceExtname =~ /^\\.(py|java|c|h|cpp|cc|cxx|hpp|cs|js|mjs|cjs|jsx|ts|tsx|kt|kts|rs|pas|dpr|pp|lpr|cob|cbl|cobol|pde)$/",
          "group": "z_struktogramm@1"
        },
        {
          "command": "struktogramm.toCode",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@2"
        },
        {
          "command": "struktogramm.openInStructorizer",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@3"
        },
        {
          "command": "struktogramm.export",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@4"
        }
      ],
      "commandPalette": [
        {
          "command": "struktogramm.exportSvg",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.exportPng",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.exportSingle",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.json",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.xml",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.aiClip",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.run",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.step",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.pause",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.stop",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.execution.clear",
          "when": "struktograf.execInPanel"
        },
        {
          "command": "struktogramm.tools.resetLayout",
          "when": "struktograf.toolsInSidebar"
        },
        {
          "command": "struktogramm.zoomIn",
          "when": "false"
        },
        {
          "command": "struktogramm.zoomOut",
          "when": "false"
        },
        {
          "command": "struktogramm.zoomReset",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "struktogramm.trueLabel": {
          "type": "string",
          "default": "",
          "description": "%config.trueLabel%"
        },
        "struktogramm.falseLabel": {
          "type": "string",
          "default": "",
          "description": "%config.falseLabel%"
        },
        "struktogramm.prettyOperators": {
          "type": "boolean",
          "default": true,
          "description": "%config.prettyOperators%"
        },
        "struktogramm.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.theme.enum0%",
            "%config.theme.enum1%",
            "%config.theme.enum2%"
          ],
          "description": "%config.theme%"
        },
        "struktogramm.exportTheme": {
          "type": "string",
          "enum": [
            "ask",
            "editor",
            "light",
            "dark"
          ],
          "default": "ask",
          "enumDescriptions": [
            "%config.exportTheme.enum0%",
            "%config.exportTheme.enum1%",
            "%config.exportTheme.enum2%",
            "%config.exportTheme.enum3%"
          ],
          "description": "%config.exportTheme%"
        },
        "struktogramm.highlightKeywords": {
          "type": "boolean",
          "default": true,
          "description": "%config.highlightKeywords%"
        },
        "struktogramm.defaultTargetLanguage": {
          "type": "string",
          "default": "",
          "description": "%config.defaultTargetLanguage%"
        },
        "struktogramm.importEngine": {
          "type": "string",
          "enum": [
            "eigene",
            "structorizer"
          ],
          "default": "eigene",
          "enumDescriptions": [
            "%config.importEngine.enum0%",
            "%config.importEngine.enum1%"
          ],
          "description": "%config.importEngine%"
        },
        "struktogramm.structorizer.jarPath": {
          "type": "string",
          "default": "",
          "description": "%config.structorizer.jarPath%"
        },
        "struktogramm.structorizer.javaPath": {
          "type": "string",
          "default": "java",
          "description": "%config.structorizer.javaPath%"
        },
        "struktogramm.structorizer.exportOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.structorizer.exportOptions%"
        },
        "struktogramm.executionPanelLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "panel",
          "enumDescriptions": [
            "%config.executionPanelLocation.enum0%",
            "%config.executionPanelLocation.enum1%"
          ],
          "markdownDescription": "%config.executionPanelLocation%"
        },
        "struktogramm.toolbarLocation": {
          "type": "string",
          "enum": [
            "editor",
            "sidebar"
          ],
          "default": "editor",
          "enumDescriptions": [
            "%config.toolbarLocation.enum0%",
            "%config.toolbarLocation.enum1%"
          ],
          "markdownDescription": "%config.toolbarLocation%"
        }
      }
    },
    "keybindings": [
      {
        "command": "struktogramm.run",
        "key": "f5",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.step",
        "key": "f10",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.step",
        "key": "f11",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.pause",
        "key": "f6",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.stop",
        "key": "shift+f5",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "struktograf.diagramFocus"
      }
    ],
    "debuggers": [
      {
        "type": "struktogramm",
        "label": "%debugger.label%",
        "languages": [
          "nsd"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.program%",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debugger.stopOnEntry%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "struktogramm",
            "request": "launch",
            "name": "%debugger.configName%",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.snippet%",
            "description": "%debugger.snippet.desc%",
            "body": {
              "type": "struktogramm",
              "request": "launch",
              "name": "%debugger.configName%",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "nsd"
      }
    ]
  }
}
