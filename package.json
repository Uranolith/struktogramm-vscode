{
  "name": "struktogramm",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.2",
  "publisher": "Uranolith",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#173a8c",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uranolith/struktogramm-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Uranolith/struktogramm-vscode/issues"
  },
  "homepage": "https://github.com/Uranolith/struktogramm-vscode#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Programming Languages"
  ],
  "keywords": [
    "struktogramm",
    "nassi-shneiderman",
    "structorizer",
    "nsd",
    "flowchart",
    "ausführen",
    "debugger",
    "cobol"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node test/tasktest.js"
  },
  "activationEvents": [
    "onDebugResolve:struktogramm",
    "onDebugDynamicConfigurations:struktogramm",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "struktogramm.editor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.nsd"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "struktograf",
          "title": "%container.struktograf%",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "struktografExecution",
          "title": "%container.execution%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "struktograf": [
        {
          "type": "webview",
          "id": "struktograf.tools",
          "name": "%view.tools%",
          "when": "struktograf.toolsInSidebar"
        }
      ],
      "struktografExecution": [
        {
          "type": "webview",
          "id": "struktograf.execution",
          "name": "%view.execution%",
          "when": "struktograf.execInPanel"
        }
      ]
    },
    "languages": [
      {
        "id": "nsd",
        "aliases": [
          "%lang.nsd%",
          "nsd"
        ],
        "extensions": [
          ".nsd"
        ],
        "configuration": "./syntaxes/nsd.language-configuration.json",
        "icon": {
          "light": "./media/nsd-light.svg",
          "dark": "./media/nsd-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nsd",
        "scopeName": "text.xml.nsd",
        "path": "./syntaxes/nsd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "struktogramm.fromCode",
        "title": "%cmd.fromCode%",
        "category": "%category%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "struktogramm.preview",
        "title": "%cmd.preview%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "struktogramm.toCode",
        "title": "%cmd.toCode%",
        "category": "%category%",
        "icon": "$(code)"
      },
      {
        "command": "struktogramm.newFile",
        "title": "%cmd.newFile%",
        "shortTitle": "%cmd.newFile.short%",
        "category": "%category%",
        "icon": "$(struktograf-new-file)"
      },
      {
        "command": "struktogramm.exportSvg",
        "title": "%cmd.exportSvg%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.exportPng",
        "title": "%cmd.exportPng%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.exportSingle",
        "title": "%cmd.exportSingle%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.fromCodeStructorizer",
        "title": "%cmd.fromCodeStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.run",
        "title": "%cmd.run%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "struktogramm.step",
        "title": "%cmd.step%",
        "category": "%category%",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "struktogramm.stop",
        "title": "%cmd.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "struktogramm.openInStructorizer",
        "title": "%cmd.openInStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.setupStructorizer",
        "title": "%cmd.setupStructorizer%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export",
        "title": "%cmd.export%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "struktogramm.export.json",
        "title": "%cmd.export.json%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export.xml",
        "title": "%cmd.export.xml%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.export.aiClip",
        "title": "%cmd.export.aiClip%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "struktogramm.pause",
        "title": "%cmd.pause%",
        "category": "%category%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "struktogramm.toggleToolbarLocation",
        "title": "%cmd.toggleToolbarLocation%",
        "category": "%category%",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "struktogramm.execution.clear",
        "title": "%cmd.execution.clear%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "struktogramm.toggleExecutionLocation",
        "title": "%cmd.toggleExecutionLocation%",
        "category": "%category%",
        "icon": "$(layout-panel)"
      },
      {
        "command": "struktogramm.tools.resetLayout",
        "title": "%cmd.tools.resetLayout%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "struktogramm.zoomIn",
        "title": "%cmd.zoomIn%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.zoomOut",
        "title": "%cmd.zoomOut%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.zoomReset",
        "title": "%cmd.zoomReset%",
        "category": "%category%"
      },
      {
        "command": "struktogramm.debug",
        "title": "%cmd.debug%",
        "category": "%category%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "struktogramm.runNoDebug",
        "title": "%cmd.runNoDebug%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "struktogramm.openSettings",
        "title": "%cmd.openSettings%",
        "category": "%category%",
        "icon": "$(gear)"
      }
    ],
    "icons": {
      "struktograf-new-file": {
        "description": "%icon.newFile%",
        "default": {
          "fontPath": "media/struktograf-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "struktogramm.preview",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(kt|kts|rs)$/",
          "group": "navigation"
        },
        {
          "command": "struktogramm.toCode",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation"
        },
        {
          "command": "struktogramm.export",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@9"
        },
        {
          "command": "struktogramm.newFile",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "1_struktogramm@1"
        },
        {
          "command": "struktogramm.toggleToolbarLocation",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@10"
        },
        {
          "command": "struktogramm.openSettings",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@11"
        },
        {
          "command": "struktogramm.toggleExecutionLocation",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "1_struktogramm@2"
        }
      ],
      "file/newFile": [
        {
          "command": "struktogramm.newFile",
          "group": "file"
        }
      ],
      "view/title": [
        {
          "command": "struktogramm.newFile",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.toggleToolbarLocation",
          "when": "view == struktograf.tools",
          "group": "navigation"
        },
        {
          "command": "struktogramm.run",
          "when": "view == struktograf.execution",
          "group": "navigation@1"
        },
        {
          "command": "struktogramm.step",
          "when": "view == struktograf.execution",
          "group": "navigation@2"
        },
        {
          "command": "struktogramm.pause",
          "when": "view == struktograf.execution",
          "group": "navigation@3"
        },
        {
          "command": "struktogramm.stop",
          "when": "view == struktograf.execution",
          "group": "navigation@4"
        },
        {
          "command": "struktogramm.execution.clear",
          "when": "view == struktograf.execution",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.toggleExecutionLocation",
          "when": "view == struktograf.execution",
          "group": "navigation@6"
        },
        {
          "command": "struktogramm.tools.resetLayout",
          "when": "view == struktograf.tools",
          "group": "9_layout"
        }
      ],
      "editor/context": [
        {
          "command": "struktogramm.fromCode",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(cob|cbl|cobol|pde|kt|kts|rs)$/",
          "group": "z_struktogramm@1"
        },
        {
          "command": "struktogramm.fromCodeStructorizer",
          "when": "resourceExtname =~ /^\\.(c|java|cob|cbl|cobol|pde)$/",
          "group": "z_struktogramm@2"
        },
        {
          "command": "struktogramm.preview",
          "when": "editorLangId =~ /^(python|java|c|cpp|csharp|javascript|typescript|javascriptreact|typescriptreact|kotlin|rust)$/ || resourceExtname =~ /^\\.(kt|kts|rs)$/",
          "group": "z_struktogramm@3"
        }
      ],
      "explorer/context": [
        {
          "command": "struktogramm.newFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@5"
        },
        {
          "command": "struktogramm.run",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@0"
        },
        {
          "command": "struktogramm.fromCode",
          "when": "resourceExtname =~ /^\\.(py|java|c|h|cpp|cc|cxx|hpp|cs|js|mjs|cjs|jsx|ts|tsx|kt|kts|rs|cob|cbl|cobol|pde)$/",
          "group": "z_struktogramm@1"
        },
        {
          "command": "struktogramm.toCode",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@2"
        },
        {
          "command": "struktogramm.openInStructorizer",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@3"
        },
        {
          "command": "struktogramm.export",
          "when": "resourceExtname == .nsd",
          "group": "z_struktogramm@4"
        }
      ],
      "commandPalette": [
        {
          "command": "struktogramm.exportSvg",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.exportPng",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.exportSingle",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.json",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.xml",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.export.aiClip",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.run",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.step",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.pause",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.stop",
          "when": "activeCustomEditorId == 'struktogramm.editor' || activeWebviewPanelId == 'struktogramm.preview'"
        },
        {
          "command": "struktogramm.execution.clear",
          "when": "struktograf.execInPanel"
        },
        {
          "command": "struktogramm.tools.resetLayout",
          "when": "struktograf.toolsInSidebar"
        },
        {
          "command": "struktogramm.zoomIn",
          "when": "false"
        },
        {
          "command": "struktogramm.zoomOut",
          "when": "false"
        },
        {
          "command": "struktogramm.zoomReset",
          "when": "false"
        },
        {
          "command": "struktogramm.debug",
          "when": "activeCustomEditorId == struktogramm.editor"
        },
        {
          "command": "struktogramm.runNoDebug",
          "when": "activeCustomEditorId == struktogramm.editor"
        }
      ],
      "editor/title/run": [
        {
          "command": "struktogramm.debug",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@0"
        },
        {
          "command": "struktogramm.runNoDebug",
          "when": "activeCustomEditorId == struktogramm.editor",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": [
      {
        "id": "struktogramm.general",
        "title": "%config.group.general%",
        "order": 0,
        "properties": {
          "struktogramm.language": {
            "type": "string",
            "enum": [
              "auto",
              "de",
              "en"
            ],
            "default": "auto",
            "enumDescriptions": [
              "%config.language.enum0%",
              "%config.language.enum1%",
              "%config.language.enum2%"
            ],
            "markdownDescription": "%config.language%",
            "order": 0
          },
          "struktogramm.toolbarLocation": {
            "type": "string",
            "enum": [
              "editor",
              "sidebar"
            ],
            "default": "editor",
            "enumDescriptions": [
              "%config.toolbarLocation.enum0%",
              "%config.toolbarLocation.enum1%"
            ],
            "markdownDescription": "%config.toolbarLocation%",
            "order": 1
          },
          "struktogramm.executionPanelLocation": {
            "type": "string",
            "enum": [
              "editor",
              "panel"
            ],
            "default": "panel",
            "enumDescriptions": [
              "%config.executionPanelLocation.enum0%",
              "%config.executionPanelLocation.enum1%"
            ],
            "markdownDescription": "%config.executionPanelLocation%",
            "order": 2
          }
        }
      },
      {
        "id": "struktogramm.display",
        "title": "%config.group.display%",
        "order": 1,
        "properties": {
          "struktogramm.theme": {
            "type": "string",
            "enum": [
              "auto",
              "light",
              "dark"
            ],
            "default": "auto",
            "enumDescriptions": [
              "%config.theme.enum0%",
              "%config.theme.enum1%",
              "%config.theme.enum2%"
            ],
            "description": "%config.theme%",
            "order": 0
          },
          "struktogramm.exportTheme": {
            "type": "string",
            "enum": [
              "ask",
              "editor",
              "light",
              "dark"
            ],
            "default": "ask",
            "enumDescriptions": [
              "%config.exportTheme.enum0%",
              "%config.exportTheme.enum1%",
              "%config.exportTheme.enum2%",
              "%config.exportTheme.enum3%"
            ],
            "description": "%config.exportTheme%",
            "order": 1
          },
          "struktogramm.highlightKeywords": {
            "type": "boolean",
            "default": true,
            "description": "%config.highlightKeywords%",
            "order": 2
          },
          "struktogramm.prettyOperators": {
            "type": "boolean",
            "default": true,
            "description": "%config.prettyOperators%",
            "order": 3
          },
          "struktogramm.assignmentOperator": {
            "type": "string",
            "enum": [
              "asWritten",
              ":=",
              "<-"
            ],
            "default": "asWritten",
            "enumDescriptions": [
              "%config.assignmentOperator.enum0%",
              "%config.assignmentOperator.enum1%",
              "%config.assignmentOperator.enum2%"
            ],
            "markdownDescription": "%config.assignmentOperator%",
            "order": 4
          },
          "struktogramm.trueLabel": {
            "type": "string",
            "default": "",
            "description": "%config.trueLabel%",
            "order": 5
          },
          "struktogramm.falseLabel": {
            "type": "string",
            "default": "",
            "description": "%config.falseLabel%",
            "order": 6
          }
        }
      },
      {
        "id": "struktogramm.checks",
        "title": "%config.group.checks%",
        "order": 2,
        "properties": {
          "struktogramm.checks": {
            "type": "string",
            "enum": [
              "all",
              "errors",
              "off"
            ],
            "default": "all",
            "enumDescriptions": [
              "%config.checks.enum0%",
              "%config.checks.enum1%",
              "%config.checks.enum2%"
            ],
            "markdownDescription": "%config.checks%",
            "order": 0
          },
          "struktogramm.hints.bestPractice": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.hints.bestPractice%",
            "order": 1
          },
          "struktogramm.hints.conventions": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.hints.conventions%",
            "order": 2
          },
          "struktogramm.hints.confusion": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.hints.confusion%",
            "order": 3
          },
          "struktogramm.hints.logic": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.hints.logic%",
            "order": 4
          }
        }
      },
      {
        "id": "struktogramm.code",
        "title": "%config.group.code%",
        "order": 3,
        "properties": {
          "struktogramm.defaultTargetLanguage": {
            "type": "string",
            "default": "",
            "description": "%config.defaultTargetLanguage%",
            "order": 0
          },
          "struktogramm.importEngine": {
            "type": "string",
            "enum": [
              "eigene",
              "structorizer"
            ],
            "default": "eigene",
            "enumDescriptions": [
              "%config.importEngine.enum0%",
              "%config.importEngine.enum1%"
            ],
            "description": "%config.importEngine%",
            "order": 1
          }
        }
      },
      {
        "id": "struktogramm.structorizer",
        "title": "%config.group.structorizer%",
        "order": 4,
        "properties": {
          "struktogramm.structorizer.jarPath": {
            "type": "string",
            "default": "",
            "description": "%config.structorizer.jarPath%",
            "order": 0
          },
          "struktogramm.structorizer.javaPath": {
            "type": "string",
            "default": "java",
            "description": "%config.structorizer.javaPath%",
            "order": 1
          },
          "struktogramm.structorizer.exportOptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.structorizer.exportOptions%",
            "order": 2
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "struktogramm.run",
        "key": "f5",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.step",
        "key": "f10",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.step",
        "key": "f11",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.pause",
        "key": "f6",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.stop",
        "key": "shift+f5",
        "when": "activeCustomEditorId == 'struktogramm.editor' && debugType != 'struktogramm' || activeWebviewPanelId == 'struktogramm.preview'"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "struktograf.diagramFocus"
      },
      {
        "command": "struktogramm.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "struktograf.diagramFocus"
      }
    ],
    "debuggers": [
      {
        "type": "struktogramm",
        "label": "%debugger.label%",
        "languages": [
          "nsd"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.program%",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debugger.stopOnEntry%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "struktogramm",
            "request": "launch",
            "name": "%debugger.configName%",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.snippet%",
            "description": "%debugger.snippet.desc%",
            "body": {
              "type": "struktogramm",
              "request": "launch",
              "name": "%debugger.configName%",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "nsd"
      }
    ],
    "viewsWelcome": [
      {
        "view": "debug",
        "contents": "%welcome.debug%",
        "when": "activeCustomEditorId == struktogramm.editor"
      }
    ]
  }
}
